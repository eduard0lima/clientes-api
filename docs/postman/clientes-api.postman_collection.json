    { "key": "userUsername", "value": "usuario", "type": "string" },
    { "key": "userPassword", "value": "usuario123", "type": "string" },
    { "key": "rabbitmqUsername", "value": "clientes", "type": "string" },
    { "key": "rabbitmqPassword", "value": "clientes", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "userToken", "value": "", "type": "string" },
    { "key": "customerId", "value": "", "type": "string" },
